# registry-auth-proxy — example environment configuration.
# Copy to `.env` and adjust. Do NOT commit a real .env or a real client secret.
#
# All values are read at startup by internal/config. Required values have no
# default and cause the process to exit non-zero if unset.

# HTTP listen port (optional; default 8181).
PORT=8181

# Distribution registry base URL the proxy forwards to. Internal address —
# bypasses any public Cloudflare tunnel. Required.
UPSTREAM_URL=http://registry.registry.svc.cluster.local:5000

# Registry token service GET /token endpoint. Internal address so the token
# exchange never leaves the cluster. Required.
TOKEN_ENDPOINT=http://token-service.registry.svc.cluster.local:8080/token

# Hydra client_id used for HTTP Basic auth to the token service (optional;
# default shown). This identity should have read-only pull + catalog only.
CLIENT_ID=registry-browser

# Path to a file containing the client secret. The secret is read from this
# file and NEVER from an inline environment variable, so it can be mounted from
# a Kubernetes Secret without appearing in the process environment. Required.
CLIENT_SECRET_FILE=/etc/registry-auth-proxy/client-secret

# Evict cached tokens this long before their stated expiry, so callers always
# get a token with useful remaining lifetime (optional; default 30s).
TOKEN_REFRESH_MARGIN=30s

# Log verbosity: debug | info | warn | error (optional; default info).
LOG_LEVEL=info
